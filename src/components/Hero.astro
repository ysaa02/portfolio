---
import { Image } from "astro:assets";
import portrait from "../assets/portrait.png";
import { profile } from "../data/profile";
---

<section id="top" class="hero">
  <div class="hero-text">
    <p class="prompt">$ whoami</p>
    <h1>{profile.name}</h1>
    <p class="role">{profile.role}</p>
    <p class="lead">{profile.intro}</p>
    <p class="badge">{profile.education}</p>
    <div class="ctas">
      <a class="btn" href="#projects">[ see work ]</a>
      <a class="btn ghost" href="#contact">[ let's talk ]</a>
    </div>
  </div>
  <Image class="portrait" src={portrait} alt={`Portrait of ${profile.loaderName}`} widths={[360, 560, 840]} sizes="(max-width: 767px) 280px, 40vw" format="webp" loading="eager" fetchpriority="high" />
</section>
