---
// Inline SVG icon from src/icons/<set>/<name>.svg. Icons take the text color and size of their surroundings.
// The set comes from PUBLIC_ICON_SET at build time (default "lucide").
const svgs = import.meta.glob<string>("../icons/*/*.svg", { query: "?raw", import: "default", eager: true });

export type IconName = "sun" | "moon" | "chat" | "close" | "send" | "visit" | "mail" | "github" | "linkedin";
interface Props {
  name: IconName;
}
const { name } = Astro.props;
const set = import.meta.env.PUBLIC_ICON_SET ?? "lucide";
const raw = svgs[`../icons/${set}/${name}.svg`];
if (!raw) throw new Error(`Missing icon: src/icons/${set}/${name}.svg`);

// Drop the license comment and the root tag's fixed size and classes; inner shapes stay untouched.
const svg = raw
  .replace(/<!--[\s\S]*?-->/g, "")
  .replace(/<svg[^>]*>/, (tag) =>
    tag.replace(/\s(width|height|class)="[^"]*"/g, "").replace("<svg", '<svg class="icon" aria-hidden="true" focusable="false"'),
  )
  .trim();
---

<Fragment set:html={svg} />
