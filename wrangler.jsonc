// Cloudflare Workers config: serves the static build in dist/ at
// https://elaisa-laguerta-portfolio.laguertaelaisa.workers.dev and runs worker/index.ts for /api/*.
// The Gemini key is a secret: `npx wrangler@4 secret put GEMINI_API_KEY` (production), `.dev.vars` (local).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "elaisa-laguerta-portfolio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "GEMINI_MODEL": "gemini-3.1-flash-lite"
  },
  // Per-visitor limit on chat messages, so the key can't be used to run up a bill.
  "ratelimits": [
    {
      "name": "CHAT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "observability": { "enabled": true }
}
